/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "minifarms-worker",
	"main": "src/main.ts",
	"compatibility_date": "2026-07-14",
	"assets": {
		// The path to the directory containing the `index.html` file to be served at `/`
		"directory": "./public",
		"binding": "ASSETS",
		// Set this for all assets we want to pre-render
		"run_worker_first": ["/blog/*"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	 "kv_namespaces": [
    {
      "binding": "MINIFARMS_BLOG_KV",
      "id": "51f0171098db4ee6ac7853223f21f7c8"
    }
  ],
  "rules": [
	{
		"type": "Text",
		"globs": ["**/*.html"],
		"fallthrough": true
	}
  ]
}